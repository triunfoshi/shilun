SHILUN_TUSHARE_TOKEN=your_tushare_token
SHILUN_TUSHARE_BASE_URL=http://lianghua.nanyangqiankun.top
SHILUN_TUSHARE_TIMEOUT=10
SHILUN_MONGO_URI=mongodb://localhost:27017
SHILUN_MONGO_DB=shilun
SHILUN_API_HOST=127.0.0.1
SHILUN_API_PORT=8000
SHILUN_API_LOG_LEVEL=info
SHILUN_AUTH_REQUIRED=false
SHILUN_AUTH_USERNAME=replace_with_private_username
SHILUN_AUTH_PASSWORD=replace_with_a_long_random_password
SHILUN_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SHILUN_TELEGRAM_WEBHOOK_BASE_URL=https://your-public-domain.example.com
SHILUN_TELEGRAM_WEBHOOK_SECRET=your_random_secret
SHILUN_TELEGRAM_ALLOWED_CHAT_IDS=123456789
SHILUN_TELEGRAM_PUSH_CHAT_IDS=123456789
SHILUN_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook
# SDK app credentials for ECS/Linux; macOS can reuse lark-cli's encrypted store.
SHILUN_FEISHU_APP_ID=
SHILUN_FEISHU_APP_SECRET=
SHILUN_FEISHU_BRAND=feishu
# Empty on this Mac: use the sole user configured for the matching CLI app.
SHILUN_FEISHU_ALLOWED_OPEN_IDS=
# Production stores messages, sessions and events in the configured ECS Mongo.
SHILUN_FEISHU_STORE=mongo
SHILUN_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
SHILUN_CODEX_TIMEOUT_SECONDS=600
SHILUN_CODEX_MODEL=gpt-6-luna
SHILUN_CODEX_REASONING_EFFORT=low
SHILUN_CODEX_SERVICE_TIER=priority
# Optional: match an existing local proxy; applied only to the Codex child.
# SHILUN_CODEX_PROXY=http://127.0.0.1:7897
SHILUN_CODEX_REVIEW_API_BASE=http://127.0.0.1:8000
SHILUN_INTRADAY_NOTIFICATIONS_ENABLED=true

# Official default: idx_mins. Set stk_mins only for a gateway verified to serve index bars there.
SHILUN_TUSHARE_INDEX_MINUTE_API=idx_mins

# local for offline research; mongo for the shared ECS-published theme archives
SHILUN_THEME_ARCHIVE_BACKEND=local
