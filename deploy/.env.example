# Copy to deploy/.env. Never commit the populated file.
SHILUN_TUSHARE_TOKEN=replace_me
SHILUN_TUSHARE_BASE_URL=https://your-tushare-gateway.example.com
SHILUN_TUSHARE_TIMEOUT=15

# Prefer an ApsaraDB for MongoDB private/VPC URI. Do not expose port 27017 publicly.
SHILUN_MONGO_URI=mongodb://shilun_app:replace_me@dds-example.mongodb.rds.aliyuncs.com:3717/shilun?authSource=admin
SHILUN_MONGO_DB=shilun

SHILUN_AUTH_REQUIRED=true
SHILUN_AUTH_USERNAME=trader
SHILUN_AUTH_PASSWORD=replace_with_at_least_24_random_characters
SHILUN_API_LOG_LEVEL=info

SHILUN_TELEGRAM_BOT_TOKEN=
SHILUN_TELEGRAM_WEBHOOK_BASE_URL=https://trade.example.com
SHILUN_TELEGRAM_WEBHOOK_SECRET=
SHILUN_TELEGRAM_ALLOWED_CHAT_IDS=
SHILUN_TELEGRAM_PUSH_CHAT_IDS=
SHILUN_FEISHU_WEBHOOK_URL=
SHILUN_INTRADAY_NOTIFICATIONS_ENABLED=false
